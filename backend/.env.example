# ===== EDUHUB — Backend (.env) =====
# Copier ce fichier en `.env` et renseigner chaque valeur.
# Aucune donnée sensible ne doit être codée en dur dans le code.

# --- Serveur ---
PORT=5000
NODE_ENV=development

# --- Base de données MongoDB (l'une des deux suffit) ---
MONGODB_URI=mongodb://localhost:27017/eduhub
# MONGO_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/eduhub

# --- Sécurité ---
# Clé secrète JWT (obligatoire — changer absolument en production)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
# Secret des sessions Passport/express-session
SESSION_SECRET=changez-moi-aussi

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Email (Nodemailer) — vérification, mot de passe oublié, contact ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre.adresse@gmail.com
EMAIL_PASS=votre-mot-de-passe-application
EMAIL_FROM=EDUHUB <votre.adresse@gmail.com>

# --- Cloudinary (avatars, images de cours) ---
CLOUDINARY_CLOUD_NAME=votre-cloud
CLOUDINARY_API_KEY=votre-cle-api
CLOUDINARY_API_SECRET=votre-secret-api

# --- Stripe (cours payants) ---
# SK_TEST_... en développement
STRIPE_SECRET_KEY=sk_test_...
# Clé de signature du webhook (starts with whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...
# Devise de facturation (eur par défaut — usd ou tnd possibles)
STRIPE_CURRENCY=eur
